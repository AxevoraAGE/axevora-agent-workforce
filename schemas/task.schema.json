{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXEVORA Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "product",
    "title",
    "objective",
    "assigned_role",
    "status",
    "priority",
    "acceptance_criteria",
    "deliverables",
    "verification_method"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^AXE-[A-Z]{2,4}-[0-9]{3,}$"
    },
    "product": {
      "enum": [
        "AXEVORA Music Lab",
        "AXEVORA Language Learning",
        "Shared Workforce"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "assigned_role": {
      "type": "string",
      "minLength": 2
    },
    "reviewer_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "ASSIGNED",
        "IN_PROGRESS",
        "REVIEW_REQUIRED",
        "APPROVED",
        "BLOCKED",
        "REJECTED",
        "COMPLETED"
      ]
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification_method": {
      "type": "string",
      "minLength": 5
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_approval_required": {
      "type": "boolean"
    },
    "owner_approval": {
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}